<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10182D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">


        <!-- ============================================= -->
        <!-- BARRA SUPERIOR -->
        <!-- ============================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="◈"
                android:textColor="#6D9CFF"
                android:textSize="22sp"/>

            <EditText
                android:id="@+id/edtPesquisa"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_search"
                android:hint="Buscar"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textSize="12sp"
                android:textColor="#333333"
                android:textColorHint="#777777"/>

            <TextView
                android:layout_width="30dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="⌕"
                android:textColor="#FFFFFF"
                android:textSize="21sp"/>

        </LinearLayout>


        <!-- ============================================= -->
        <!-- MENU -->
        <!-- ============================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/menuTeste"
                android:layout_width="78dp"
                android:layout_height="32dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_chip_selected"
                android:gravity="center"
                android:text="▣  Teste"
                android:textColor="#17172A"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/menuResultado"
                android:layout_width="96dp"
                android:layout_height="32dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:text="◷  Resultado"
                android:textColor="#17172A"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/menuAreas"
                android:layout_width="108dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:text="▤  Áreas em TI"
                android:textColor="#17172A"
                android:textSize="10sp"/>

        </LinearLayout>


        <!-- ============================================= -->
        <!-- TÍTULO -->
        <!-- ============================================= -->

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="Teste Vocacional"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp"/>


        <!-- ============================================= -->
        <!-- CARD DA PERGUNTA -->
        <!-- ============================================= -->

        <LinearLayout
            android:id="@+id/cardPergunta"
            android:layout_width="match_parent"
            android:layout_height="430dp"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:background="@drawable/bg_vocacional_card">


            <!-- PERGUNTA -->

            <TextView
                android:id="@+id/txtPergunta"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:gravity="center"
                android:text="Gosto de criar interfaces visualmente organizadas e agradáveis."
                android:textColor="#25253A"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>


            <!-- CONCORDO TOTALMENTE -->

            <TextView
                android:id="@+id/opcao1"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_option"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="○  Concordo totalmente"
                android:textColor="#45454D"
                android:textStyle="bold"
                android:textSize="13sp"/>


            <!-- CONCORDO -->

            <TextView
                android:id="@+id/opcao2"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_option"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="○  Concordo"
                android:textColor="#45454D"
                android:textStyle="bold"
                android:textSize="13sp"/>


            <!-- NEUTRO -->

            <TextView
                android:id="@+id/opcao3"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_option"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="○  Neutro"
                android:textColor="#45454D"
                android:textStyle="bold"
                android:textSize="13sp"/>


            <!-- DISCORDO -->

            <TextView
                android:id="@+id/opcao4"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_option"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="○  Discordo"
                android:textColor="#45454D"
                android:textStyle="bold"
                android:textSize="13sp"/>


            <!-- DISCORDO TOTALMENTE -->

            <TextView
                android:id="@+id/opcao5"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_option"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="○  Discordo totalmente"
                android:textColor="#45454D"
                android:textStyle="bold"
                android:textSize="13sp"/>

        </LinearLayout>


        <!-- ============================================= -->
        <!-- NAVEGAÇÃO -->
        <!-- ============================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnAnterior"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="32sp"/>


            <ProgressBar
                android:id="@+id/progresso"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:max="18"
                android:progress="1"
                android:progressTint="#7654D9"
                android:backgroundTint="#E9E4F2"/>


            <TextView
                android:id="@+id/btnProximo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="›"
                android:textColor="#FFFFFF"
                android:textSize="32sp"/>

        </LinearLayout>


        <!-- NÚMERO DA PERGUNTA -->

        <TextView
            android:id="@+id/txtNumeroPergunta"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="1 de 18"
            android:textColor="#FFFFFF"
            android:textSize="11sp"/>

    </LinearLayout>

</ScrollView>